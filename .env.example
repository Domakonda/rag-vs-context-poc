# Copy to .env and fill in. .env must stay out of git.
OPENAI_API_KEY=

# Optional overrides. If set, these win over ragchat.config.json.
# Changing the embedding model requires re-indexing: uv run ragchat ingest --reset
# RAGCHAT_EMBEDDING_MODEL=text-embedding-3-large
# RAGCHAT_LLM_MODEL=gpt-6-luna
